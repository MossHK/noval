{
  "name": "open-script-studio",
  "version": "0.1.0",
  "description": "Self-hosted AI script adaptation studio for turning novels, story notes, and worldbuilding references into production-ready scripts and handoff packages.",
  "main": "src/server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MossHK/noval.git"
  },
  "homepage": "https://github.com/MossHK/noval#readme",
  "bugs": {
    "url": "https://github.com/MossHK/noval/issues"
  },
  "scripts": {
    "start": "node src/server.js",
    "check": "node --check src/server.js && node --check src/script_studio.js && node --check public/script-studio-assets/app.js",
    "scan:secrets": "! rg -n \"(sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|(ghp|gho|ghu|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|BEGIN ([R]SA|[D]SA|[E]C|[O]PENSSH|[P]RIVATE) KEY|p[o]stgres(ql)?://|m[o]ngodb://|m[y]sql://|r[e]dis://|https?://[^[:space:]\\\"'<>/@]+:[^[:space:]\\\"'<>/@]+@)\" . --glob '!node_modules/**' --glob '!package-lock.json'"
  },
  "keywords": [
    "script",
    "story",
    "adaptation",
    "screenwriting",
    "anthropic",
    "openai"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "yauzl": "^3.2.0"
  }
}
